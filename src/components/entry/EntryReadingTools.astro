---
// Server-rendered parts the long-form enhancements attach to: the diagram
// toolbar template, the reading-progress bar and the image viewer. Shared by
// `EntryPage` and `DocumentPage`, which both call `mountEntryEnhancements`.
import DiagramControls from '@/components/primitives/DiagramControls.astro'
import EntryLightbox from '@/components/entry/EntryLightbox.astro'
import type { Locale } from '@/i18n'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
---

<DiagramControls locale={locale} />
<div class="read-progress" aria-hidden="true">
  <span data-read-progress></span>
</div>
<EntryLightbox locale={locale} />

---
// Authoring component for .mdx entries: a prominent link out to a repository
// README (or any long-form source). Styles live in archive.css (.readme-card).
// Part of the MDX authoring kit: kept even while no entry imports it, so a
// dead-code sweep should not remove it. See docs/architecture.md.
import { getDictionary, getLocaleFromPath } from '@/i18n'
import { renderIcon } from '@/lib/icons'

interface Props {
  href: string
  repo?: string
  label?: string
}
// MDX components receive no locale, so the default label follows the page URL.
const {
  href,
  repo,
  label = getDictionary(getLocaleFromPath(Astro.url.pathname)).archive
    .readFullReadme,
} = Astro.props
---

<a class="readme-card" href={href} target="_blank" rel="noopener noreferrer">
  <span
    class="readme-card__icon"
    aria-hidden="true"
    set:html={renderIcon('citations')}
  />
  <span class="readme-card__text">
    {repo && <span class="readme-card__kind">{repo}</span>}
    <strong>{label}</strong>
  </span>
  <span
    class="readme-card__go"
    aria-hidden="true"
    set:html={renderIcon('external', 16)}
  />
</a>

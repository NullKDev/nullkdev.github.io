---
import { getDictionary, getLocalizedPath, type Locale } from '@i18n/index'
import { brand } from '@/data/brand'
import BrandMark from '@/components/primitives/BrandMark.astro'
import { renderIcon } from '@/lib/icons'

interface Props {
  locale: Locale
  pathname: string
  counterpartPath?: string
}

const { locale, pathname, counterpartPath } = Astro.props
const dictionary = getDictionary(locale)
const otherLocale = locale === 'en' ? 'es' : 'en'
const sections = ['work', 'lab', 'notes', 'gallery', 'about'] as const
const currentSection = sections.find((section) =>
  pathname.includes(`/${section}`),
)
const localeFallback = getLocalizedPath(
  currentSection ? `/${currentSection}/` : '/',
  otherLocale,
)
---

<header class="site-header">
  <a
    class="wordmark"
    href={getLocalizedPath('/', locale)}
    aria-label={dictionary.nav.home}
  >
    <BrandMark />
    <span>{brand.mark}</span>
  </a>
  <nav class="desktop-nav" aria-label={dictionary.nav.primary}>
    {
      sections.map((section) => (
        <a
          href={getLocalizedPath(`/${section}`, locale)}
          aria-current={pathname.includes(`/${section}`) ? 'page' : undefined}
        >
          {dictionary.nav[section]}
        </a>
      ))
    }
  </nav>
  <div class="header-tools">
    <button
      class="icon-control"
      type="button"
      data-theme-toggle
      aria-label={dictionary.nav.themeToDark}
      aria-pressed="false"
      data-label-light={dictionary.nav.themeToLight}
      data-label-dark={dictionary.nav.themeToDark}
      ><span
        class="theme-icon-light"
        aria-hidden="true"
        set:html={renderIcon('sun', 18)}
      /><span
        class="theme-icon-dark"
        aria-hidden="true"
        set:html={renderIcon('moon', 18)}
      /></button
    >
    <a
      class="locale-control"
      href={counterpartPath ?? localeFallback}
      aria-label={dictionary.nav.language}
      hreflang={otherLocale}
      data-locale-control
    >
      {otherLocale.toUpperCase()}
    </a>
    <button
      class="menu-control"
      type="button"
      data-menu-open
      aria-label={dictionary.nav.menu}
      aria-controls="mobile-navigation"
      aria-expanded="false">{dictionary.nav.menuText}</button
    >
  </div>
</header>

<dialog
  id="mobile-navigation"
  class="mobile-drawer"
  data-mobile-drawer
  aria-labelledby="mobile-nav-title"
>
  <div class="drawer-heading">
    <span id="mobile-nav-title" class="wordmark">
      <BrandMark />
      <span>{brand.mark}</span>
    </span>
    <button type="button" data-menu-close aria-label={dictionary.nav.close}
      >{dictionary.nav.closeText}</button
    >
  </div>
  <nav aria-label={dictionary.nav.primary}>
    {
      sections.map((section) => (
        <a
          href={getLocalizedPath(`/${section}`, locale)}
          aria-current={pathname.includes(`/${section}`) ? 'page' : undefined}
        >
          {dictionary.nav[section]}
        </a>
      ))
    }
  </nav>
</dialog>

<script>
  const drawer = document.querySelector<HTMLDialogElement>(
    '[data-mobile-drawer]',
  )
  const openButton =
    document.querySelector<HTMLButtonElement>('[data-menu-open]')
  const closeButton =
    document.querySelector<HTMLButtonElement>('[data-menu-close]')
  openButton?.addEventListener('click', () => {
    drawer?.showModal()
    openButton.setAttribute('aria-expanded', 'true')
  })
  const closeDrawer = () => {
    if (drawer?.open) drawer.close()
    openButton?.setAttribute('aria-expanded', 'false')
  }
  closeButton?.addEventListener('click', closeDrawer)
  drawer?.addEventListener('click', (event) => {
    if (event.target === drawer) closeDrawer()
  })
  drawer?.addEventListener('close', () => {
    openButton?.setAttribute('aria-expanded', 'false')
  })
  drawer?.addEventListener('cancel', () => {
    openButton?.setAttribute('aria-expanded', 'false')
  })

  const themeButton = document.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]',
  )
  const syncThemeButton = () => {
    if (!themeButton) return
    const dark = document.documentElement.dataset.theme === 'dark'
    themeButton.setAttribute('aria-pressed', String(dark))
    themeButton.setAttribute(
      'aria-label',
      dark
        ? (themeButton.dataset.labelLight ?? '')
        : (themeButton.dataset.labelDark ?? ''),
    )
  }
  if (themeButton) {
    syncThemeButton()
    themeButton.addEventListener('click', () => {
      const root = document.documentElement
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
      root.dataset.theme = next
      syncThemeButton()
      try {
        localStorage.setItem('nullkdev-theme', next)
      } catch {
        /* Theme persistence is optional. */
      }
    })
  }

  const header = document.querySelector<HTMLElement>('.site-header')
  if (header) {
    let ticking = false
    const updateScrolled = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 4)
      ticking = false
    }
    updateScrolled()
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true
          requestAnimationFrame(updateScrolled)
        }
      },
      { passive: true },
    )
  }
</script>

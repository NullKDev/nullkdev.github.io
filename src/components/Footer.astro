---
import BrandMark from '@/components/primitives/BrandMark.astro'
import { brand } from '@/data/brand'
import Icon from '@/components/primitives/Icon.astro'
import { about } from '@/data/about'
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n'

interface Props {
  locale: Locale
  pathname: string
}
const { locale, pathname } = Astro.props
const dictionary = getDictionary(locale)
const profile = about[locale]
const year = new Date().getFullYear()
const primary = ['work', 'lab', 'notes', 'gallery', 'about'] as const
const reference = ['uses', 'stack', 'tags', 'colophon'] as const
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a
        class="wordmark"
        href={getLocalizedPath('/', locale)}
        aria-label={dictionary.nav.home}
      >
        <BrandMark />
        <span>{brand.mark}</span>
      </a>
      <p class="footer-statement">{dictionary.footer.statement}</p>
      <p class="footer-loc">
        <span aria-hidden="true"></span>{profile.location}
      </p>
    </div>

    <nav class="footer-col" aria-label={dictionary.footer.archive}>
      <p class="footer-col-title">{dictionary.footer.archive}</p>
      {
        primary.map((item) => (
          <a
            href={getLocalizedPath(`/${item}`, locale)}
            aria-current={pathname.includes(`/${item}`) ? 'page' : undefined}
          >
            {dictionary.nav[item]}
          </a>
        ))
      }
    </nav>

    <nav class="footer-col" aria-label={dictionary.footer.reference}>
      <p class="footer-col-title">{dictionary.footer.reference}</p>
      {
        reference.map((item) => (
          <a
            href={getLocalizedPath(`/${item}`, locale)}
            aria-current={pathname.includes(`/${item}`) ? 'page' : undefined}
          >
            {dictionary.secondary[item]}
          </a>
        ))
      }
    </nav>

    <nav class="footer-col" aria-label={dictionary.footer.connect}>
      <p class="footer-col-title">{dictionary.footer.connect}</p>
      {
        profile.links.map((link) => (
          <a href={link.href} rel="me">
            <Icon name={link.icon} size={15} />
            {link.label}
          </a>
        ))
      }
      <a href="/rss.xml">
        <Icon name="feed" size={15} />
        {dictionary.footer.feed}
      </a>
      <a href="https://github.com/NullKDev/nullkdev.github.io" rel="me">
        <Icon name="repository" size={15} />
        {dictionary.footer.source}
      </a>
    </nav>
  </div>

  <div class="footer-bottom">
    <p class="footer-copy">
      © {year} Carlos Alarcon · {dictionary.footer.builtWith}
    </p>
    <a class="footer-toplink" href="#main-content">
      {dictionary.footer.backToTop}<Icon name="arrowUp" size={14} />
    </a>
  </div>
</footer>

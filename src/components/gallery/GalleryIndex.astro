---
import type { CollectionEntry } from 'astro:content'
import { pageTitle } from '@/data/brand'
import Breadcrumb from '@/components/primitives/Breadcrumb.astro'
import StatusChip from '@/components/primitives/StatusChip.astro'
import {
  getAlternateLocale,
  getDictionary,
  getLocalizedPath,
  type Locale,
} from '@/i18n'
import { getArchiveLabel } from '@/i18n/archive'
import Layout from '@/layouts/Layout.astro'
import { buildCollectionPageLd } from '@/lib/structured-data'
import GalleryImage from '@/components/gallery/GalleryImage.astro'
import { getEntryPath, getGallerySheets } from '@/lib/content'
import { formatPieceCount, galleryStill } from '@/lib/gallery'
import '@/styles/global.css'
import '@/styles/archive.css'
import '@/styles/sections/gallery-index.css'

interface Props {
  locale: Locale
  entries: CollectionEntry<'gallery'>[]
}

const { locale, entries } = Astro.props
const dictionary = getDictionary(locale)

const { sheets, totals } = await getGallerySheets(entries)
const pieceWord =
  totals.pieces === 1 ? dictionary.gallery.item : dictionary.gallery.items

/* Same `CollectionPage` treatment as the other index surfaces — Lab and
   Gallery render through their own components, which is how they were the last
   two indexable pages left without structured data. */
const collectionJsonLd = buildCollectionPageLd({
  name: dictionary.nav.gallery,
  description: dictionary.section.gallery,
  locale,
  site: Astro.site,
})
---

<Layout
  locale={locale}
  title={pageTitle(dictionary.nav.gallery)}
  description={dictionary.section.gallery}
  alternatePath={getLocalizedPath('/gallery/', getAlternateLocale(locale))}
  jsonLd={collectionJsonLd}
>
  <main class="gallery-index">
    <header class="gallery-head">
      <Breadcrumb
        locale={locale}
        trail={[
          { label: dictionary.nav.home, href: getLocalizedPath('/', locale) },
          { label: dictionary.nav.gallery },
        ]}
      />
      <h1>{dictionary.nav.gallery}</h1>
      <p class="gallery-lead">{dictionary.gallery.lead}</p>
      <dl class="gallery-tally">
        <div>
          <dt>
            {
              totals.collections === 1
                ? dictionary.gallery.collection
                : dictionary.gallery.collections
            }
          </dt>
          <dd>{totals.collections}</dd>
        </div>
        <div>
          <dt>{pieceWord}</dt>
          <dd>{totals.pieces}</dd>
        </div>
        {
          totals.generated > 0 && (
            <div>
              <dt>{dictionary.gallery.generated}</dt>
              <dd>{totals.generated}</dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      sheets.length ? (
        <ul class="gallery-shelf">
          {sheets.map(({ entry, thumbs, tally, generated, items }) => (
            <li>
              <article
                class="gallery-sheet"
                data-empty={thumbs.length === 0 ? '' : undefined}
              >
                <a
                  class="gallery-sheet__hit"
                  href={getEntryPath(entry)}
                  aria-label={entry.data.title}
                />

                <div class="gallery-sheet__contact" data-count={thumbs.length}>
                  {thumbs.map((item, index) => (
                    <GalleryImage
                      src={galleryStill(item) ?? ''}
                      alt=""
                      dimensions={item.data.dimensions}
                      widths={index === 0 ? [240, 480] : [160, 320]}
                      sizes={index === 0 ? '15rem' : '9rem'}
                    />
                  ))}
                  {items.length > thumbs.length && thumbs.length > 0 && (
                    <span class="gallery-sheet__more">
                      {formatPieceCount(items.length, dictionary.archive)}
                    </span>
                  )}
                </div>

                <div class="gallery-sheet__body">
                  <p class="gallery-sheet__kind">
                    {getArchiveLabel('galleryKind', entry.data.kind, locale)}
                    <StatusChip
                      lifecycle={entry.data.lifecycle}
                      locale={locale}
                      size="sm"
                    />
                  </p>
                  <h2>{entry.data.title}</h2>
                  <p class="gallery-sheet__summary">{entry.data.summary}</p>
                  <ul class="gallery-sheet__tally">
                    {tally.map(({ type, count }) => (
                      <li>
                        <b>{count}</b>{' '}
                        {getArchiveLabel(
                          count === 1 ? 'itemType' : 'itemTypePlural',
                          type,
                          locale,
                        )}
                      </li>
                    ))}
                    {generated > 0 && (
                      <li data-generated>
                        <b>{generated}</b> {dictionary.gallery.generated}
                      </li>
                    )}
                  </ul>
                </div>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="gallery-empty">{dictionary.section.empty}</p>
      )
    }
  </main>
</Layout>

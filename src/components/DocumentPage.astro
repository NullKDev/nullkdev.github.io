---
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n'
import { pageTitle } from '@/data/brand'
import { render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import {
  getAdjacentDocuments,
  getDocumentCounterpartPath,
  getDocumentPath,
  getDocumentRelationships,
  getEntryDomain,
  getEntryPath,
  type ArchiveDocument,
  type ArchiveEntry,
} from '@/lib/content'
import { getTopicLabel } from '@/data/taxonomy'
import { getArchiveLabel } from '@/i18n/archive'
import { buildDocumentOutline } from '@/lib/outline'
import { buildDocumentArticleLd } from '@/lib/structured-data'
import EntryOutline from '@/components/entry/EntryOutline.astro'
import EntryReadingTools from '@/components/entry/EntryReadingTools.astro'
import EvidenceList from '@/components/entry/EvidenceList.astro'
import RelationshipList from '@/components/entry/RelationshipList.astro'
import Icon from '@/components/primitives/Icon.astro'

interface Props {
  entry: ArchiveEntry
  document: ArchiveDocument
  locale: Locale
}
const { entry, document, locale } = Astro.props
const dictionary = getDictionary(locale)
const domain = getEntryDomain(entry)
const counterpartPath = await getDocumentCounterpartPath(entry, document)
const adjacent = await getAdjacentDocuments(entry, document)
const relationships = await getDocumentRelationships(document)
const { Content, headings } = await render(document)
// The same depth rule the subpost gets when its entry inlines it.
const outline = buildDocumentOutline(headings)

/* Just the subpost. Concatenating the parent title produced 153-character
   <title> elements that a search result truncates into uselessness — "How
   pretext works: two phases… — Pretext: the 15 kb library that…". The
   relationship is already carried by the breadcrumb, the canonical URL and the
   JSON-LD; the title does not need to restate it. */
const documentTitle = pageTitle(document.data.title)
const jsonLd = buildDocumentArticleLd({
  title: document.data.title,
  summary: document.data.summary,
  locale,
  path: getDocumentPath(entry, document),
  parentPath: getEntryPath(entry),
  publishedAt: document.data.publishedAt,
  updatedAt: document.data.updatedAt,
  site: Astro.site,
})
---

<Layout
  locale={locale}
  title={documentTitle}
  description={document.data.summary}
  counterpartPath={counterpartPath}
  jsonLd={jsonLd}
>
  <main
    class="entry-page document-page"
    data-copy={dictionary.archive.copy}
    data-copied={dictionary.archive.copied}
  >
    <EntryReadingTools locale={locale} />
    <nav class="breadcrumbs" aria-label={dictionary.archive.breadcrumb}>
      <a href={getLocalizedPath(`/${domain}`, locale)}
        >{dictionary.nav[domain]}</a
      ><span aria-hidden="true">/</span><a href={getEntryPath(entry)}
        >{entry.data.title}</a
      ><span aria-hidden="true">/</span><span aria-current="page"
        >{document.data.title}</span
      >
    </nav>
    <header class="entry-heading">
      <p class="kicker">
        {getArchiveLabel('domain', domain, locale)} / {
          String(document.data.order).padStart(2, '0')
        }
      </p><h1>{document.data.title}</h1><p class="lede">
        {document.data.summary}
      </p>
    </header>
    <div class="entry-layout">
      <article class="prose"><Content /></article><aside
        class="entry-index"
        aria-label={dictionary.archive.contents}
      >
        <EntryOutline items={outline} locale={locale} /><h2>
          {dictionary.archive.topics}
        </h2><ul class="topic-list">
          {
            document.data.topics.map((topic) => (
              <li>{getTopicLabel(topic, locale)}</li>
            ))
          }
        </ul>
      </aside>
    </div>
    {
      (document.data.evidence.length > 0 || relationships.length > 0) && (
        <div class="entry-record">
          <EvidenceList items={document.data.evidence} locale={locale} />
          <RelationshipList
            title={dictionary.archive.references}
            items={relationships}
            locale={locale}
          />
        </div>
      )
    }
    <nav class="series-navigation" aria-label={dictionary.archive.documents}>
      <div>
        {
          adjacent.previous && (
            <a href={getDocumentPath(entry, adjacent.previous)}>
              <Icon name="arrowLeft" size={14} />
              {dictionary.archive.previous}: {adjacent.previous.data.title}
            </a>
          )
        }
        {
          adjacent.next && (
            <a href={getDocumentPath(entry, adjacent.next)}>
              {dictionary.archive.next}: {adjacent.next.data.title}
              <Icon name="arrowRight" size={14} />
            </a>
          )
        }
      </div>
    </nav>
    <a class="back-link" href={getEntryPath(entry)}
      ><Icon name="arrowLeft" size={14} />{dictionary.archive.back}
      {entry.data.title}</a
    >
  </main>
</Layout>

<script>
  import { mountEntryEnhancements } from '@/lib/entry-enhancements'

  // A subpost read on its own URL gets the same reading tools as the entry
  // that inlines it: copy buttons, figures and the image viewer, diagram zoom,
  // reading progress and the active-section marker. Mounting only the diagram
  // viewer left the same code block copyable in one place and not the other.
  mountEntryEnhancements(document.querySelector<HTMLElement>('.entry-page'))
</script>

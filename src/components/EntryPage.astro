---
import type { CollectionEntry } from 'astro:content'
import { pageTitle } from '@/data/brand'
import Breadcrumb from '@/components/primitives/Breadcrumb.astro'
import EntryContentsCompact from '@/components/entry/EntryContentsCompact.astro'
import EntryOutline from '@/components/entry/EntryOutline.astro'
import EntryReadingTools from '@/components/entry/EntryReadingTools.astro'
import EvidenceList from '@/components/entry/EvidenceList.astro'
import RecordBlockHead from '@/components/entry/RecordBlockHead.astro'
import RelationshipList from '@/components/entry/RelationshipList.astro'
import Icon from '@/components/primitives/Icon.astro'
import StatusChip from '@/components/primitives/StatusChip.astro'
import LabConsole from '@/components/lab/LabConsole.astro'
import LabSpec from '@/components/lab/LabSpec.astro'
import LabWorkbench from '@/components/lab/LabWorkbench'
import GalleryItems from '@/components/gallery/GalleryItems.astro'
import RelatedLab from '@/components/lab/RelatedLab.astro'
import { render } from 'astro:content'
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n'
import { bannerStyle, getBannerSources } from '@/lib/banners'
import Layout from '@/layouts/Layout.astro'
import {
  getAdjacentEntries,
  getArchiveEntries,
  getCounterpartEntry,
  getDocumentsForEntry,
  getEntryAlternatePath,
  getEntryCounterpartPath,
  getEntryDomain,
  getEntryPath,
  getEntryRelationships,
  getGalleryItems,
  getNotesSeriesNavigation,
  type ArchiveEntry,
} from '@/lib/content'
import { getTopicLabel } from '@/data/taxonomy'
import { getArchiveLabel } from '@/i18n/archive'
import { getRelatedLabEntries } from '@/lib/lab'
import { renderIcon } from '@/lib/icons'
import { getNeighbourAge, getReadingMinutes } from '@/lib/notes'
import {
  buildEntryOutline,
  getCounterpartAnchors,
  getPartAnchor,
  type OutlinePart,
} from '@/lib/outline'
import { buildEntryArticleLd } from '@/lib/structured-data'
import '@/styles/global.css'
import '@/styles/archive.css'
import '@/styles/sections/entry.css'
import '@/styles/sections/prose.css'
import '@/styles/sections/lab-entry.css'
import '@/styles/sections/gallery-detail.css'

interface Props {
  entry: ArchiveEntry
  locale: Locale
}
const { entry, locale } = Astro.props
const dictionary = getDictionary(locale)
const domain = getEntryDomain(entry)
const documents = await getDocumentsForEntry(entry)
const counterpartPath = await getEntryCounterpartPath(entry)
const alternatePath = await getEntryAlternatePath(entry)
const series = await getNotesSeriesNavigation(entry)
const adjacent = await getAdjacentEntries(entry)
const relationships = await getEntryRelationships(entry)
const { Content, headings } = await render(entry)

// Lab records are framed as instruments, not as reading — the console, the
// declared spec, and derived neighbours replace the article furniture.
const galleryItems = domain === 'gallery' ? await getGalleryItems(entry) : []
const isLab = domain === 'lab'
const labEntry = isLab ? (entry as CollectionEntry<'lab'>) : undefined
const relatedLab = labEntry
  ? getRelatedLabEntries(
      labEntry,
      (await getArchiveEntries('lab', locale)) as CollectionEntry<'lab'>[],
    )
  : []

// Render subposts inline so the whole series reads as one thread under one URL.
const renderedDocuments = await Promise.all(
  documents.map(async (document) => ({
    document,
    rendered: await render(document),
  })),
)

// Reading time counts the subposts too: they render inline on this page.
const readingMinutes = getReadingMinutes([
  entry.body,
  ...documents.map((document) => document.body),
])

// One anchored outline spanning the entry and its subposts; see lib/outline.
// Each part carries its own reading time, so a collapsed part still says how
// long it is.
const toPart = (
  document: (typeof documents)[number],
  partHeadings: OutlinePart['headings'],
): OutlinePart => ({
  slug: getPartAnchor(document.data.order),
  title: document.data.title,
  minutes: getReadingMinutes([document.body]),
  headings: partHeadings,
})
const tableOfContents = buildEntryOutline(
  headings,
  renderedDocuments.map(({ document, rendered }) =>
    toPart(document, rendered.headings),
  ),
)

// The translation's outline, so the language switch can land on the same
// section (heading i → heading i). Only kept when both outlines match; see
// `getCounterpartAnchors`.
const counterpart = await getCounterpartEntry(entry)
const counterpartOutline = counterpart
  ? buildEntryOutline(
      (await render(counterpart)).headings,
      await Promise.all(
        (await getDocumentsForEntry(counterpart)).map(async (document) =>
          toPart(document, (await render(document)).headings),
        ),
      ),
    )
  : undefined
const counterpartAnchors = getCounterpartAnchors(
  tableOfContents,
  counterpartOutline,
)

// Inside a series the date pager sits under the series navigation. Two
// "Previous" links pointing at different notes read as a contradiction, so
// there the pager names the direction in time instead.
const inSeries = Boolean(series && series.total > 1)
const pagerLabel = (
  neighbour: ArchiveEntry | undefined,
  fallback: string,
): string => {
  if (!inSeries || !neighbour) return fallback
  const age = getNeighbourAge(
    entry.data.publishedAt,
    neighbour.data.publishedAt,
  )
  if (age === 'newer') return dictionary.archive.newerNote
  if (age === 'older') return dictionary.archive.olderNote
  return fallback
}

/* One derivation for every surface that renders a banner — see
   `src/lib/banners.ts` for why it does not live here. */
const banner = getBannerSources(entry.data.image, locale)
const socialImage = banner?.social

const published = entry.data.publishedAt
const updated = entry.data.updatedAt ?? entry.data.publishedAt
const role = 'role' in entry.data ? entry.data.role : undefined

// Typed link marks come from the shared registry so the same drawing is never
// redefined per component.
const checkIcon = renderIcon('check')
const linkIcon: Record<string, string> = {
  repository: renderIcon('repository'),
  release: renderIcon('release'),
  demo: renderIcon('demo'),
  publication: renderIcon('publication'),
  external: renderIcon('external'),
}
const jsonLd = buildEntryArticleLd({
  domain,
  title: entry.data.title,
  summary: entry.data.summary,
  locale,
  path: getEntryPath(entry),
  image: socialImage,
  publishedAt: entry.data.publishedAt,
  updatedAt: entry.data.updatedAt,
  site: Astro.site,
})
---

<Layout
  locale={locale}
  title={pageTitle(entry.data.title)}
  description={entry.data.summary}
  counterpartPath={counterpartPath}
  alternatePath={alternatePath}
  image={socialImage}
  imageAlt={banner ? entry.data.imageAlt : undefined}
  jsonLd={jsonLd}
>
  <main
    class="entry-page"
    data-domain={domain}
    data-counterpart-anchors={counterpartAnchors
      ? JSON.stringify(counterpartAnchors)
      : undefined}
    data-copy={dictionary.archive.copy}
    data-copied={dictionary.archive.copied}
    data-note-key={isLab
      ? undefined
      : domain === 'notes'
        ? entry.data.translationKey
        : undefined}
  >
    <EntryReadingTools locale={locale} />
    <Breadcrumb
      locale={locale}
      trail={[
        { label: dictionary.nav.home, href: getLocalizedPath('/', locale) },
        {
          label: dictionary.nav[domain],
          href: getLocalizedPath(`/${domain}`, locale),
        },
        { label: entry.data.title },
      ]}
    />
    <header class="entry-heading">
      <p class="entry-chips">
        {
          labEntry && (
            <span class="entry-kind">
              {labEntry.data.kind === 'experiment'
                ? dictionary.lab.experiment
                : dictionary.lab.tool}
            </span>
          )
        }
        <StatusChip lifecycle={entry.data.lifecycle} locale={locale} />
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <dl class="entry-facts">
        {
          role && (
            <div class="fact fact--text">
              <dt>{dictionary.archive.role}</dt>
              <dd>{role}</dd>
            </div>
          )
        }
        {
          published && (
            <div class="fact">
              <dt>{dictionary.archive.published}</dt>
              <dd>
                <time datetime={published.toISOString()}>
                  {published.toLocaleDateString(locale, {
                    dateStyle: 'medium',
                  })}
                </time>
              </dd>
            </div>
          )
        }
        {
          updated && entry.data.updatedAt && (
            <div class="fact">
              <dt>{dictionary.archive.updated}</dt>
              <dd>
                <time datetime={updated.toISOString()}>
                  {updated.toLocaleDateString(locale, { dateStyle: 'medium' })}
                </time>
              </dd>
            </div>
          )
        }
        {
          galleryItems.length > 0 ? (
            <div class="fact">
              <dt>{dictionary.gallery.pieces}</dt>
              <dd>{galleryItems.length}</dd>
            </div>
          ) : labEntry ? (
            <div class="fact fact--text">
              <dt>{dictionary.lab.maturity}</dt>
              <dd>
                {getArchiveLabel('maturity', labEntry.data.maturity, locale)}
              </dd>
            </div>
          ) : (
            <div class="fact">
              <dt>{dictionary.archive.reading}</dt>
              <dd>
                {readingMinutes} {dictionary.archive.readTime}
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      entry.data.image && (
        <figure class="entry-banner" style={bannerStyle(banner)}>
          <img
            src={banner?.dark ?? entry.data.image}
            alt={entry.data.imageAlt ?? ''}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
          />
        </figure>
      )
    }

    {
      entry.data.statusNote && (
        <aside class="status-note" aria-label={dictionary.archive.status}>
          <>
            <strong>
              {labEntry
                ? dictionary.lab.scopeLimits
                : dictionary.archive.statusNote}
            </strong>
            <p>{entry.data.statusNote}</p>
          </>
        </aside>
      )
    }

    {
      labEntry && labEntry.data.implementationId && (
        <LabConsole entry={labEntry} locale={locale}>
          <LabWorkbench
            client:idle
            implementationId={labEntry.data.implementationId}
            locale={locale}
          />
          <noscript>
            <p class="lab-noscript">{dictionary.archive.labNoScript}</p>
          </noscript>
          <p class="lab-noscript lab-nojs-fallback">
            {dictionary.archive.labNoScript}
          </p>
        </LabConsole>
      )
    }

    {labEntry && <LabSpec entry={labEntry} locale={locale} />}

    {
      galleryItems.length > 0 && (
        <GalleryItems items={galleryItems} locale={locale} />
      )
    }

    <EntryContentsCompact items={tableOfContents} locale={locale} />

    <div class="entry-layout">
      <article class="prose">
        <Content />
        {
          renderedDocuments.map(({ document, rendered }) => {
            const DocumentContent = rendered.Content
            return (
              <section class="subpost" id={getPartAnchor(document.data.order)}>
                <p class="subpost-index">
                  {dictionary.archive.part} {document.data.order} /{' '}
                  {documents.length}
                </p>
                <h2>{document.data.title}</h2>
                <DocumentContent />
              </section>
            )
          })
        }
      </article>
      <div class="entry-index">
        <EntryOutline items={tableOfContents} locale={locale} />
      </div>
    </div>

    {
      entry.data.topics.length > 0 && (
        <section class="entry-topics" aria-labelledby="entry-topics-title">
          <h2 id="entry-topics-title">{dictionary.archive.topics}</h2>
          <ul class="topic-list">
            {entry.data.topics.map((topic) => (
              <li>
                <a href={getLocalizedPath(`/tags#${topic}`, locale)}>
                  {getTopicLabel(topic, locale)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (('outcomes' in entry.data && entry.data.outcomes.length > 0) ||
        ('operatingConditions' in entry.data &&
          entry.data.operatingConditions.length > 0) ||
        entry.data.evidence.length > 0 ||
        ('citations' in entry.data && entry.data.citations.length > 0) ||
        entry.data.links.length > 0 ||
        relationships.references.length > 0 ||
        relationships.backlinks.length > 0) && (
        <div class="entry-record">
          {'outcomes' in entry.data && entry.data.outcomes.length > 0 && (
            <section class="record-block">
              <RecordBlockHead
                icon="outcomes"
                title={dictionary.archive.outcomes}
                count={entry.data.outcomes.length}
              />
              <ol class="outcome-list">
                {entry.data.outcomes.map((outcome) => (
                  <li class="outcome">
                    <span
                      class="outcome__mark"
                      aria-hidden="true"
                      set:html={checkIcon}
                    />
                    <div class="outcome__body">
                      <p class="outcome__claim">{outcome.label}</p>
                      <ul class="cite-line">
                        {outcome.evidence.map((ev) => (
                          <li>
                            <span class="cite-line__source">{ev.source}</span>
                            <span class="prov" data-prov={ev.provenance}>
                              {getArchiveLabel(
                                'provenance',
                                ev.provenance,
                                locale,
                              )}
                            </span>
                            {ev.url && (
                              <a href={ev.url}>
                                {dictionary.archive.source}
                                <Icon name="external" size={13} />
                              </a>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )}
          {'operatingConditions' in entry.data &&
            entry.data.operatingConditions.length > 0 && (
              <section class="record-block">
                <RecordBlockHead
                  icon="conditions"
                  title={dictionary.archive.conditions}
                  count={entry.data.operatingConditions.length}
                />
                <dl class="condition-list">
                  {entry.data.operatingConditions.map(
                    ({ condition, implication }) => (
                      <div class="condition">
                        <dt>{condition}</dt>
                        <dd>{implication}</dd>
                      </div>
                    ),
                  )}
                </dl>
              </section>
            )}
          <EvidenceList items={entry.data.evidence} locale={locale} />
          {'citations' in entry.data && entry.data.citations.length > 0 && (
            <section class="record-block">
              <RecordBlockHead
                icon="citations"
                title={dictionary.archive.citations}
                count={entry.data.citations.length}
              />
              <ul class="citation-list">
                {entry.data.citations.map((citation) => (
                  <li>
                    <a href={citation.url}>
                      <strong>{citation.title}</strong>
                      <Icon name="external" size={13} />
                    </a>
                    {citation.accessedAt && (
                      <span class="citation-list__date">
                        {dictionary.archive.updated}{' '}
                        {citation.accessedAt.toLocaleDateString(locale)}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )}
          {entry.data.links.length > 0 && (
            <section class="record-block">
              <RecordBlockHead icon="links" title={dictionary.archive.links} />
              <div class="record-links">
                {entry.data.links.map((link) => (
                  <a href={link.href} class="record-link">
                    <span
                      class="record-link__icon"
                      aria-hidden="true"
                      set:html={linkIcon[link.kind] ?? linkIcon.external}
                    />
                    <span class="record-link__text">
                      <span class="record-link__kind">
                        {getArchiveLabel('linkKind', link.kind, locale)}
                      </span>
                      <strong>{link.label}</strong>
                    </span>
                    <span class="record-link__go">
                      <Icon name="external" size={15} />
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )}
          <RelationshipList
            title={dictionary.archive.references}
            items={relationships.references}
            locale={locale}
          />
          <RelationshipList
            title={dictionary.archive.backlinks}
            items={relationships.backlinks}
            locale={locale}
          />
        </div>
      )
    }
    <RelatedLab entries={relatedLab} locale={locale} />
    {
      series && inSeries && (
        <nav class="series-navigation" aria-label={dictionary.archive.series}>
          <p>
            <strong>
              {dictionary.archive.series}: {series.id}
            </strong>
            <span>
              {dictionary.archive.part} {series.order} / {series.total}
            </span>
          </p>
          <div>
            {series.previous && (
              <a href={getEntryPath(series.previous)}>
                <Icon name="arrowLeft" size={14} />
                {dictionary.archive.previous}: {series.previous.data.title}
              </a>
            )}
            {series.next && (
              <a href={getEntryPath(series.next)}>
                {dictionary.archive.next}: {series.next.data.title}
                <Icon name="arrowRight" size={14} />
              </a>
            )}
          </div>
        </nav>
      )
    }
    {
      (adjacent.previous || adjacent.next) && (
        <nav class="entry-pager" aria-label={dictionary.archive.pager}>
          {adjacent.previous ? (
            <a
              class="pager-link"
              data-dir="prev"
              href={getEntryPath(adjacent.previous)}
            >
              <span class="pager-link__label">
                <Icon name="arrowLeft" size={14} />{' '}
                {pagerLabel(adjacent.previous, dictionary.archive.previous)}
              </span>
              <span class="pager-link__title">
                {adjacent.previous.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {adjacent.next && (
            <a
              class="pager-link"
              data-dir="next"
              href={getEntryPath(adjacent.next)}
            >
              <span class="pager-link__label">
                {pagerLabel(adjacent.next, dictionary.archive.next)}{' '}
                <Icon name="arrowRight" size={14} />
              </span>
              <span class="pager-link__title">{adjacent.next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </main>
</Layout>

<script>
  import { mountEntryEnhancements } from '@/lib/entry-enhancements'
  import { markRead } from '@/lib/reading-log'

  const main = document.querySelector<HTMLElement>('.entry-page')
  // Opening a note records it locally so the index can show what is left.
  const noteKey = main?.dataset.noteKey
  if (noteKey) markRead(noteKey)
  mountEntryEnhancements(main)
</script>

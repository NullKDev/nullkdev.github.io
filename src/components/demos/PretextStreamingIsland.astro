---
// Server-side seat for the streaming-chat island. An island cannot read the
// page's locale or the build-time icon registry, so this wrapper resolves both
// and passes plain strings. Without JavaScript the island never mounts and the
// fallback says so in the page's language, instead of an empty gap.
import PretextStreamingDemo from '@/components/demos/PretextStreamingDemo'
import { getDictionary, type Locale } from '@/i18n'
import { renderIcon } from '@/lib/icons'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { demos } = getDictionary(locale)
const icons = {
  fast: renderIcon('fast', 14),
  slow: renderIcon('slow', 14),
  play: renderIcon('play', 14),
  stop: renderIcon('stop', 14),
}
---

<PretextStreamingDemo
  client:only="react"
  labels={demos.streaming}
  icons={icons}
>
  <p class="demo-fallback" slot="fallback">{demos.needsScript}</p>
</PretextStreamingDemo>

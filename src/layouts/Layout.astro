---
import { createHash } from 'node:crypto'

import Header from '@components/Header.astro'
import { brand } from '@/data/brand'
import Footer from '@components/Footer.astro'
import Analytics from '@components/Analytics.astro'
import DesignPanel from '@components/dev/DesignPanel.astro'
import { getDictionary, type Locale } from '@i18n/index'
import '@styles/global.css'
import '@styles/archive.css'

interface Props {
  locale: Locale
  title: string
  description: string
  counterpartPath?: string
  image?: string
  noindex?: boolean
  jsonLd?: Record<string, unknown>
  canonicalPath?: string
  imageAlt?: string
}

const {
  locale,
  title,
  description,
  counterpartPath,
  image = '/og/signal-archive.png',
  imageAlt,
  noindex,
  jsonLd,
  canonicalPath,
} = Astro.props
const dictionary = getDictionary(locale)
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site)

/* Theme has to resolve before the first paint or the page flashes the wrong
   one, which rules out an external file. That means one inline script — and an
   inline script under a real CSP needs a hash, not `unsafe-inline`. Hashing the
   exact bytes we render keeps the two from ever drifting apart: edit the script
   and the hash follows on the next build. */
const themeScript = `;(() => {
  document.documentElement.dataset.js = 'true'
  let theme
  try {
    theme = localStorage.getItem('nullkdev-theme')
  } catch {
    theme = undefined
  }
  document.documentElement.dataset.theme =
    theme === 'light' || theme === 'dark'
      ? theme
      : matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light'
})()`
const themeScriptHash = createHash('sha256')
  .update(themeScript)
  .digest('base64')

/* GitHub Pages serves static files and exposes no header configuration, so the
   policy travels in the document. Two limits worth stating rather than hiding:
   `frame-ancestors` and HSTS are both ignored when a CSP arrives via meta, so
   clickjacking cannot be refused from here — that needs a host which lets you
   set response headers. A `_headers` file does nothing on Pages.

   Styles keep `unsafe-inline` because a static build has no per-request nonce.
   Scripts do not: everything executable is either a bundled module from this
   origin or the hashed theme script above. Keep this list closed — anything
   added is something a compromised dependency is then allowed to reach. */
const csp = [
  "default-src 'self'",
  `script-src 'self' 'sha256-${themeScriptHash}'`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob:",
  "font-src 'self'",
  "connect-src 'self'",
  "media-src 'self'",
  "worker-src 'self' blob:",
  "manifest-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "frame-src 'none'",
  'upgrade-insecure-requests',
].join('; ')
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link
      rel="preload"
      href="/fonts/switzer-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      /* Matches the page it sits above, not the brand tile: the browser chrome
        should continue the surface rather than announce a second colour. */
    }
    <meta
      name="theme-color"
      content="#fafbfc"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0f1c"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${brand.name} Notes`}
      href="/rss.xml"
    />
    <link rel="alternate" hreflang={locale} href={canonical} />
    {
      counterpartPath && (
        <link
          rel="alternate"
          hreflang={locale === 'en' ? 'es' : 'en'}
          href={new URL(counterpartPath, Astro.site)}
        />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content={imageAlt ?? dictionary.meta.socialImageAlt}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <meta
      name="twitter:image:alt"
      content={imageAlt ?? dictionary.meta.socialImageAlt}
    />
    <slot name="head" />
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    <title>{title}</title>
    <script is:inline set:html={themeScript} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{dictionary.nav.skip}</a>
    <Header
      locale={locale}
      pathname={Astro.url.pathname}
      counterpartPath={counterpartPath}
    />
    <div id="main-content" tabindex="-1"><slot /></div>
    <Footer locale={locale} pathname={Astro.url.pathname} />
    <DesignPanel />
  </body>
</html>

---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAlbumCount, getAllPhotos } from '@/lib/data-utils'
import { Image } from 'astro:assets'

const photoCollections = await getAllPhotos()
const albumStats = await getAlbumCount()
const totalPhotos = Object.values(albumStats).reduce((a, b) => a + b, 0)
---

<Layout class="max-w-5xl">
  <PageHead
    slot="head"
    title="AI & Photo Gallery"
    description="Curated collection of AI generations and photography."
  />
  <Breadcrumbs
    items={[
      {
        label: 'Gallery',
        href: '/photos',
        icon: 'lucide:camera',
        i18nKey: 'gallery.breadcrumb',
      },
    ]}
  />

  <!-- Hero -->
  <section class="hero-album reveal">
    <div class="cap" data-i18n="gallery.hero_cap">photos · personal</div>
    <h1>
      <span data-i18n="gallery.hero_title">Frames<br />from </span><span
        class="hl">2025</span
      >.
    </h1>
    <p class="lede" data-i18n="gallery.hero_desc">
      Calle, tipografía, viajes cortos. Tomadas con Fuji X-T30 y a veces con el
      celular.
    </p>
    <div class="albums-meta">
      <span>{photoCollections.length} álbumes</span>
      <span class="dot-sep">·</span>
      <span>{totalPhotos} fotos</span>
      <span class="dot-sep">·</span>
      <span
        >actualizado {
          new Date().toLocaleDateString('es-ES', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          })
        }</span
      >
    </div>
  </section>

  <!-- Album Grid -->
  <section class="album-grid reveal-stagger">
    {
      photoCollections.map((album, index) => {
        const imageCount = albumStats[album.id] || 0
        return (
          <a class="album" href={`/photos/${album.id}`}>
            <div class="cover">
              <Image
                src={album.data.image}
                alt={album.data.name}
                width={700}
                loading={index < 3 ? 'eager' : 'lazy'}
                class="album-img"
              />
              {album.data.protected && <span class="lock">🔒</span>}
              <div class="cover-overlay" />
            </div>
            <div class="meta">
              <h3>{album.data.name}</h3>
              <div class="meta-right">
                <span class="count">{imageCount} fotos</span>
                <span class="num">
                  {album.data.date
                    ? album.data.date.toLocaleDateString('es-ES', {
                        month: 'short',
                        year: 'numeric',
                      })
                    : 'N/A'}
                </span>
              </div>
            </div>
          </a>
        )
      })
    }
  </section>
</Layout>

<style>
  .hero-album {
    padding-top: var(--space-16);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--border);
  }
  .hero-album .cap {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .hero-album h1 {
    font-family: var(--font-sans);
    font-size: clamp(48px, 8vw, 112px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.92;
    margin: var(--space-4) 0 0;
  }
  .hero-album h1 .hl {
    color: var(--primary);
  }
  .hero-album .lede {
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--foreground-soft);
    max-width: 52ch;
    margin: var(--space-5) 0 0;
  }
  .albums-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .albums-meta .dot-sep {
    color: var(--faint);
  }

  /* Album Grid */
  .album-grid {
    margin-top: var(--space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .album {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-1);
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }
  .album:hover {
    border-color: var(--border-2);
    transform: translateY(-3px);
  }
  .album .cover {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .album-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .album:hover .album-img {
    transform: scale(1.05);
  }
  .album .cover-overlay {
    position: absolute;
    inset: 0;
    background: transparent;
    transition: background 0.3s ease;
  }
  .album:hover .cover-overlay {
    background: rgba(0, 0, 0, 0.05);
  }
  .album .cover .lock {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklab, var(--background) 80%, transparent);
    border: 1px solid var(--border-2);
    border-radius: 999px;
    font-size: 13px;
    z-index: 2;
  }
  .album .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--space-4) var(--space-5);
  }
  .album h3 {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--foreground);
    margin: 0;
    transition: color 0.2s ease;
  }
  .album:hover h3 {
    color: var(--primary);
  }
  .meta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }
  .album .count {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--primary);
    font-weight: 500;
  }
  .album .num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .album-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .album-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

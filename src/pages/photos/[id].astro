---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import PhotoAlbumSchema from '@/components/PhotoAlbumSchema.astro'
import PhotoProtection from '@/components/PhotoProtection.astro'
import { GalleryViewer } from '@/components/react/GalleryViewer'
import Layout from '@/layouts/Layout.astro'
import {
  getAlbumImages,
  getAllPhotos,
  hasPhotoTranslation,
  parseAuthors,
} from '@/lib/data-utils'
import { Image } from 'astro:assets'

export async function getStaticPaths() {
  const albums = await getAllPhotos()
  return albums.map((album) => ({
    params: { id: album.id },
    props: { album },
  }))
}

const { album } = Astro.props
const albumImages = await getAlbumImages(album.id)
const viewerImages = albumImages.map((img) => ({
  src: typeof img.src === 'object' ? img.src.src : img.src,
  fileName: img.fileName,
  width: typeof img.src === 'object' ? img.src.width : undefined,
  height: typeof img.src === 'object' ? img.src.height : undefined,
}))
const authors = await parseAuthors(album.data.authors ?? [])
const hasEsTranslation = await hasPhotoTranslation(album.id, 'es')
const coverSrc =
  typeof album.data.image === 'object'
    ? (album.data.image as { src: string }).src
    : String(album.data.image)
---

<Layout class="max-w-5xl">
  <PageHead
    slot="head"
    title={`${album.data.name} - Gallery`}
    description={album.data.description || `Gallery for ${album.data.name}`}
  />
  <PhotoAlbumSchema
    album={{
      name: album.data.name,
      title: album.data.title,
      description: album.data.description,
      image: album.data.image,
      date: album.data.date,
      authors: album.data.authors,
      id: album.id,
    }}
  />
  <meta slot="head" name="post-locale" content="en" />
  <meta slot="head" name="post-slug" content={album.id} />
  <meta slot="head" name="post-section" content="photos" />
  {hasEsTranslation && <meta slot="head" name="post-has-es" content="true" />}

  <Breadcrumbs
    items={[
      { label: 'Photos', href: '/photos', icon: 'lucide:camera' },
      { label: album.data.name, icon: 'lucide:image' },
    ]}
  />

  <!-- Album Detail -->
  <section class="album-detail reveal">
    <div class="crumbs">
      <a href="/photos" class="mono muted">photos</a>
      <span class="faint mono">/</span>
      <span style="color:var(--foreground)">{album.id}</span>
    </div>
    <a href="/photos" class="back-link" data-i18n="gallery.back">← Back to gallery</a>
    <h1>{album.data.name}.</h1>
    {album.data.description && <p class="lede">{album.data.description}</p>}
    <div class="meta-row">
      <span>{albumImages.length} fotos</span>
      <span>·</span>
      <span
        >{
          album.data.date
            ? album.data.date.toLocaleDateString('es-ES', {
                month: 'short',
                year: 'numeric',
              })
            : 'N/A'
        }</span
      >
      <span>·</span>
      <span>{album.data.model || 'Unknown'}</span>
      <span>·</span>
      <a href={coverSrc} download style="color:var(--primary)">descargar zip ↓</a>
    </div>
  </section>

  <!-- Bento Grid -->
  {
    albumImages.length > 0 && (
      <section class="bento-grid reveal-stagger" id="bento-grid">
        {albumImages.map((img, i) => {
          // Pattern: lg, sm, sm, md, sm, sm, lg... repeating
          const pattern = i % 7
          const sizeClass =
            pattern === 0 ? 'bento-lg' : pattern === 3 ? 'bento-md' : 'bento-sm'
          return (
            <div
              class={`bento-item ${sizeClass}`}
              data-i={i}
              tabindex="0"
              role="button"
              aria-label={`Open photo ${i + 1} of ${albumImages.length}`}
              onclick={`window.dispatchEvent(new CustomEvent('gallery:open',{detail:{index:${i}}}))`}
            >
              <Image
                src={img.src}
                alt={`Photo ${i + 1}`}
                width={pattern === 0 ? 1200 : 800}
                loading={i < 3 ? 'eager' : 'lazy'}
                class="bento-img"
              />
              <div class="bento-overlay">
                <span class="bento-num">{String(i + 1).padStart(2, '0')}</span>
              </div>
            </div>
          )
        })}
      </section>
    )
  }

  <script is:inline data-astro-rerun>
    ;(function () {
      var grid = document.getElementById('bento-grid')
      if (!grid) return
      var items = Array.from(grid.querySelectorAll('.bento-item'))
      if (!items.length) return

      var cols = 3
      var mql = window.matchMedia('(max-width: 560px)')
      var mql2 = window.matchMedia('(max-width: 1000px)')

      function updateCols() {
        if (mql.matches) cols = 1
        else if (mql2.matches) cols = 2
        else cols = 3
      }
      updateCols()
      mql.addEventListener('change', updateCols)
      mql2.addEventListener('change', updateCols)

      grid.addEventListener('keydown', function (e) {
        var active = document.activeElement
        if (!active || !active.classList.contains('bento-item')) return
        var idx = parseInt(active.getAttribute('data-i') || '0')
        var nextIdx = idx

        if (e.key === 'ArrowRight') {
          e.preventDefault()
          nextIdx = idx + 1
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault()
          nextIdx = idx - 1
        } else if (e.key === 'ArrowDown') {
          e.preventDefault()
          nextIdx = idx + cols
        } else if (e.key === 'ArrowUp') {
          e.preventDefault()
          nextIdx = idx - cols
        } else if (e.key === 'Enter') {
          e.preventDefault()
          window.dispatchEvent(
            new CustomEvent('gallery:open', { detail: { index: idx } }),
          )
          return
        } else {
          return
        }

        nextIdx = Math.max(0, Math.min(nextIdx, items.length - 1))
        var next = items[nextIdx]
        if (next) {
          next.focus()
          next.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
        }
      })
    })()
  </script>

  <!-- Lightbox -->
  <PhotoProtection
    isProtected={!!album.data.protected}
    password={album.data.password}
    albumId={album.id}
    coverSrc={coverSrc}
    images={viewerImages}
    protectionMessage={album.data.protectionMessage}
  >
    <GalleryViewer client:only="react" images={viewerImages} />
  </PhotoProtection>
</Layout>

<style>
  .album-detail {
    padding-top: var(--space-10);
  }
  .album-detail .back-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--primary);
    text-decoration: none;
  }
  .album-detail .back-link:hover {
    text-decoration: underline;
  }
  .album-detail .crumbs {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin-bottom: var(--space-4);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .album-detail .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .album-detail .crumbs a:hover {
    color: var(--foreground);
  }
  .album-detail h1 {
    font-family: var(--font-sans);
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }
  .album-detail .lede {
    font-family: var(--font-sans);
    color: var(--foreground-soft);
    margin-top: var(--space-4);
    max-width: 56ch;
  }
  .album-detail .meta-row {
    display: flex;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin-top: var(--space-4);
  }

  /* Bento Grid */
  .bento-grid {
    margin-top: var(--space-10);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 220px;
    gap: var(--space-3);
  }
  .bento-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
    cursor: pointer;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
    outline: none;
  }
  .bento-item:hover,
  .bento-item:focus-visible {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 0 0 2px var(--primary-tint);
  }

  /* Size variants */
  .bento-lg {
    grid-column: span 2;
    grid-row: span 2;
  }
  .bento-md {
    grid-column: span 1;
    grid-row: span 2;
  }
  .bento-sm {
    grid-column: span 1;
    grid-row: span 1;
  }

  .bento-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .bento-item:hover .bento-img {
    transform: scale(1.05);
  }

  .bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.4) 0%, transparent 40%);
    display: flex;
    align-items: flex-end;
    padding: var(--space-3) var(--space-4);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .bento-item:hover .bento-overlay {
    opacity: 1;
  }
  .bento-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
    letter-spacing: 0.04em;
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 200px;
    }
    .bento-lg {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
  @media (max-width: 560px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 240px;
    }
    .bento-lg,
    .bento-md {
      grid-column: span 1;
      grid-row: span 2;
    }
    .bento-sm {
      grid-row: span 1;
    }
  }
</style>

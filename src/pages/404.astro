---
import Layout from '@/layouts/Layout.astro'
import { pageTitle } from '@/data/brand'
---

<Layout
  locale="en"
  title={pageTitle('Record not found')}
  description="The requested archive record does not exist."
  canonicalPath="/"
  counterpartPath="/es/404/"
  noindex
>
  <script is:inline slot="head">
    if (location.pathname === '/es' || location.pathname.startsWith('/es/')) {
      location.replace('/es/404/')
    }
  </script>
  <main class="not-found-page">
    <p class="kicker">404 / Outside the index</p>
    <h1>Signal not found.</h1>
    <p>
      The requested record may have moved, remained private, or never entered
      the public archive.
    </p>
    <div class="hero-actions">
      <a href="/">Return to the archive</a><a href="/notes/">Browse Notes</a>
    </div>
  </main>
</Layout>

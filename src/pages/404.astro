---
import NotFoundPage from '@/components/NotFoundPage.astro'
import { getLocalizedPath } from '@/i18n'

const spanishNotFound = getLocalizedPath('/404/', 'es')
---

<NotFoundPage
  locale="en"
  selfPath="/404.html"
  counterpartPath={spanishNotFound}
>
  <script is:inline slot="head" define:vars={{ spanishNotFound }}>
    if (location.pathname === '/es' || location.pathname.startsWith('/es/')) {
      location.replace(spanishNotFound)
    }
  </script>
</NotFoundPage>

---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import CareerTimeline from '@/components/CareerTimeline.astro'
import Link from '@/components/Link.astro'
import NowSection from '@/components/NowSection.astro'
import PageHead from '@/components/PageHead.astro'
import SectionDivider from '@/components/SectionDivider.astro'
import { buttonVariants } from '@/components/ui/button'
import { AUTHOR } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { cn } from '@/lib/utils'

const yearsExp = new Date().getFullYear() - 2018

const skills = [
  'Kotlin',
  'Compose',
  'Flutter',
  'KMM',
  'React',
  'Next.js',
  'TypeScript',
  'Python',
  'LangChain',
  'OpenAI / Claude API',
]

const languages = [
  { name: 'Español', level: 'nativo', pct: '100%' },
  { name: 'English', level: 'C1 · profesional', pct: '82%' },
  { name: 'Português', level: 'A2 · básico', pct: '30%' },
]

const experience = [
  {
    year: '2023 — now',
    title: 'Lead Mobile Developer',
    where: 'Corporativo Overall · Lima · 100k MAU, 4.6 ★',
    right: 'Play ↗ · AppGallery ↗',
  },
  {
    year: '2018 — 2023',
    title: 'Mobile Developer',
    where: 'Agrosmart · Flutter + Android nativo · agro tech',
    right: '5 yrs',
  },
  {
    year: '2017 — 2018',
    title: 'Junior Android Dev',
    where: 'Freelance · varios clientes',
    right: '1 yr',
  },
]

const nowItems = [
  {
    text: 'Trabajando en la app de trading de Overall — migrando módulos críticos a Jetpack Compose',
    meta: 'work',
  },
  {
    text: 'Construyendo un agente LLM en Python para automatizar mis emails',
    meta: 'side',
  },
  {
    text: 'Leyendo "A Philosophy of Software Design" de John Ousterhout',
    meta: 'reading',
  },
  { text: 'Aprendiendo Português A2', meta: 'learn' },
]

const interests = [
  '→ apps mobile bien hechas',
  '→ web con react · next',
  '→ agentes con llms',
  '→ mentoría · code reviews',
]
---

<Layout class="max-w-4xl">
  <PageHead slot="head" title="About" />

  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:user' }]} />

  <section class="flex flex-col gap-12">
    <!-- Hero -->
    <div class="about-hero reveal">
      <div class="cap" data-i18n="about.hero_cap">— about</div>
      <h1 data-i18n="about.hero_title">
        Construyo producto. <span class="hl">Mobile, web & IA.</span>
      </h1>
      <p class="lede" data-i18n="about.hero_lead">
        Carlos Alarcón, desde Lima. {yearsExp} años shippeando — apps móviles que
        abren 100k personas al día, dashboards web cuando el caso lo pide, y experimentos
        con agentes LLM. Me gustan las cosas simples, los PRs cortos y escribir lo
        que aprendo.
      </p>
      <div class="ctas">
        <Link
          href={AUTHOR.social.email.href}
          class={cn(buttonVariants({ size: 'default' }), 'btn-accent')}
        >
          <span data-i18n="about.contact_btn">hello@nullkdev.dev →</span>
        </Link>
        <Link
          href="/blog"
          class={cn(
            buttonVariants({ variant: 'outline', size: 'default' }),
            'btn-ghost',
          )}
        >
          <span data-i18n="about.read_btn">léeme primero</span>
        </Link>
      </div>
    </div>

    <!-- 2-col grid -->
    <div class="about-grid reveal">
      <aside class="about-bio">
        <div class="avatar">portrait</div>
        <h2>Carlos Alarcón</h2>
        <div class="alias">
          aka <span class="accent">nullKdev</span> · he/him · Lima · {yearsExp}+
          yrs
        </div>
        <p data-i18n="about.bio_p1">
          Hoy: lead mobile en Corporativo Overall. Antes: 5 años en Agrosmart
          con Flutter para agro tech.
        </p>
        <p data-i18n="about.bio_p2">
          El núcleo es mobile (Kotlin · Compose), pero también construyo web con
          Next/React y agentes con LLMs cuando el problema lo pide. Producto
          sobre tooling.
        </p>
        <div class="links">
          <a href="https://github.com/nullkdev" target="_blank" rel="noopener noreferrer" class="chip">github ↗</a>
          <a href="https://www.linkedin.com/in/jcarlos-dev/" target="_blank" rel="noopener noreferrer" class="chip">linkedin ↗</a>
          <a href="https://x.com/nullkdev" target="_blank" rel="noopener noreferrer" class="chip">x ↗</a>
        </div>
      </aside>
      <div class="about-side">
        <div class="blk">
          <div class="cap" data-i18n="about.stack_title">stack</div>
          <h3>Mobile · Web · AI</h3>
          <div class="chips">
            {skills.map((s) => <span class="chip accent">{s}</span>)}
          </div>
        </div>
        <div class="blk">
          <div class="cap" data-i18n="about.currently">currently</div>
          <h3>Q1 2026</h3>
          <p data-i18n="about.currently_desc">
            Migrando módulos a Compose en Overall, escribiendo el blog, y
            construyendo un agente personal en Python.
          </p>
        </div>
        <div class="blk langs">
          <div class="cap" data-i18n="about.languages">idiomas</div>
          {
            languages.map((lang) => (
              <div>
                <div class="row">
                  <>
                    <span>{lang.name}</span>
                    <span class="muted">{lang.level}</span>
                  </>
                </div>
                <div class="bar">
                  <i style={`width:${lang.pct}`} />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Experience -->
    <section class="reveal">
      <SectionDivider label="section.experience" class="mb-6" />
      <CareerTimeline entries={experience} />
    </section>

    <!-- Education / Talks / Writing -->
    <section>
      <SectionDivider label="section.more" class="mb-6" />
      <div class="tri reveal-stagger">
        <div class="blk">
          <div class="cap" data-i18n="about.education">education</div>
          <h3>Ing. de Sistemas</h3>
          <p>UNMSM · Lima · 2013 — 2017</p>
          <div class="chips">
            <span class="chip">Google Android Cert</span>
            <span class="chip">JetBrains KMM</span>
          </div>
        </div>
        <div class="blk">
          <div class="cap" data-i18n="about.talks">talks</div>
          <h3>Speaking</h3>
          <p>· GDG Lima 2025 · Compose en producción</p>
          <p>· Droidcon LatAm 2024 · Migrar sin drama</p>
        </div>
        <div class="blk">
          <div class="cap" data-i18n="about.writing">writing</div>
          <h3>42 posts</h3>
          <p>
            Notas técnicas, logs, tutoriales largos. <Link
              href="/blog"
              class="text-primary">Read the blog →</Link
            >
          </p>
        </div>
      </div>
    </section>

    <!-- /now -->
    <section class="reveal">
      <SectionDivider label="section.now" class="mb-6" />
      <NowSection items={nowItems} />
    </section>

    <!-- Interests -->
    <section>
      <SectionDivider label="section.interests" class="mb-6" />
      <div class="open-row reveal">
        {interests.map((i) => <span class="chip accent">{i}</span>)}
      </div>
    </section>
  </section>
</Layout>

<style>
  .about-hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--border);
  }
  .about-hero .cap {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .about-hero h1 {
    font-family: var(--font-sans);
    font-size: clamp(48px, 8vw, 112px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.92;
    margin: var(--space-4) 0 0;
    max-width: 16ch;
  }
  .about-hero h1 .hl {
    color: var(--primary);
  }
  .about-hero .lede {
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--foreground-soft);
    max-width: 60ch;
    margin: var(--space-6) 0 0;
    line-height: 1.55;
  }
  .about-hero .ctas {
    margin-top: var(--space-6);
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .about-grid {
    padding-top: var(--space-12);
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-12);
  }
  .about-bio .avatar {
    width: 200px;
    height: 240px;
    border-radius: var(--r-md);
    background: var(--surface-1);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    color: var(--muted);
  }
  .about-bio h2 {
    font-family: var(--font-sans);
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: var(--space-6) 0 var(--space-2);
  }
  .about-bio .alias {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--foreground-soft);
    margin-bottom: var(--space-4);
  }
  .about-bio .alias .accent {
    color: var(--primary);
  }
  .about-bio p {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    color: var(--foreground-soft);
    margin: 0 0 var(--space-3);
  }
  .about-bio .links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
  .about-bio .chip {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    color: var(--foreground-soft);
  }

  .about-side .blk {
    padding: var(--space-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    margin-bottom: var(--space-3);
  }
  .about-side .cap {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 10px;
  }
  .about-side h3 {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
  }
  .about-side p,
  .about-side .small {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--foreground-soft);
    margin: 0;
    line-height: 1.55;
  }
  .about-side .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .about-side .chip {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    color: var(--foreground-soft);
  }
  .about-side .chip.accent {
    background: color-mix(in oklab, var(--primary) 18%, transparent);
    color: var(--primary-foreground);
    border-color: transparent;
  }
  .about-side .langs .row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--foreground-soft);
    margin: 6px 0 2px;
  }
  .about-side .bar {
    height: 4px;
    background: var(--background);
    border-radius: 2px;
    overflow: hidden;
  }
  .about-side .bar i {
    display: block;
    height: 100%;
    background: var(--primary);
  }

  .tri {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .tri .blk {
    padding: var(--space-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
  }

  .open-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
  .open-row .chip {
    font-family: var(--font-mono);
    font-size: 12.5px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    color: var(--foreground-soft);
  }
  .open-row .chip.accent {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: transparent;
    font-weight: 500;
  }

  @media (max-width: 1000px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .tri {
      grid-template-columns: 1fr;
    }
  }
</style>

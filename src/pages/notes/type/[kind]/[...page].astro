---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'
import NotesIndex from '@/components/notes/NotesIndex.astro'
import { assertTrackedContentIntegrity, getArchiveEntries } from '@/lib/content'
import { getAvailableKinds, getNotesMeta, NOTES_PER_PAGE } from '@/lib/notes'

// One paginated set per type that actually has entries, so a filter link is
// never a route that does not exist.
export const getStaticPaths = (async ({ paginate }) => {
  await assertTrackedContentIntegrity()
  const entries = (await getArchiveEntries(
    'notes',
    'en',
  )) as CollectionEntry<'notes'>[]
  return getAvailableKinds(entries).flatMap((kind) =>
    paginate(
      entries.filter((entry) => entry.data.kind === kind),
      { params: { kind }, props: { kind }, pageSize: NOTES_PER_PAGE },
    ),
  )
}) satisfies GetStaticPaths

const { page, kind } = Astro.props
const all = (await getArchiveEntries(
  'notes',
  'en',
)) as CollectionEntry<'notes'>[]
const meta = await getNotesMeta(all)
---

<NotesIndex locale="en" page={page} all={all} meta={meta} kind={kind} />

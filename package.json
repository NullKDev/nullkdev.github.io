{
  "name": "nullkdev.github.io",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "bun run private:generate && astro check && astro build && bun run gallery:copy && bun run private:copy && bun run private:scan && bun run csp:apply && bun run performance:check && bun run links:check && bun run metadata:check",
    "preview": "astro preview",
    "lint": "eslint src tests scripts astro.config.mjs playwright.config.ts vitest.config.ts eslint.config.js",
    "lint:fix": "eslint src tests scripts astro.config.mjs playwright.config.ts vitest.config.ts eslint.config.js --fix",
    "format": "prettier --write src tests scripts .github astro.config.mjs playwright.config.ts vitest.config.ts eslint.config.js package.json docs/foundation.md",
    "format:check": "prettier --check src tests scripts .github astro.config.mjs playwright.config.ts vitest.config.ts eslint.config.js package.json docs/foundation.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:content": "vitest run --project content",
    "test:e2e": "playwright test",
    "private:generate": "bun scripts/generate-private-content.ts",
    "private:copy": "bun scripts/copy-private-content.ts",
    "private:scan": "bun scripts/scan-private-leaks.ts",
    "performance:check": "bun scripts/check-performance-budgets.ts",
    "links:check": "bun scripts/check-built-links.ts",
    "metadata:check": "bun scripts/check-built-metadata.ts",
    "model:optimize": "bun scripts/optimize-robot-model.ts",
    "gallery:scan": "bun scripts/scan-gallery-assets.ts",
    "gallery:copy": "bun scripts/copy-gallery-assets.ts",
    "astro": "astro",
    "csp:apply": "bun scripts/apply-csp.ts",
    "audit": "bun audit --audit-level=high --ignore=GHSA-mh99-v99m-4gvg"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@chenglou/pretext": "^0.0.8",
    "@google/model-viewer": "^4.3.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sanitize-html": "^2.16.1",
    "astro": "^7.1.6",
    "astro-mermaid": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "marked": "^18.0.7",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.92",
    "@iconify/utils": "^3.1.4",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "playwright-core": "1.62.0"
  }
}
